{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "skillmatch-api",
    "Audience": "skillmatch-mobile",
    "LifetimeMinutes": 30
  },
  "PasswordHashing": {
    "WorkFactor": 12
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5
    },
    "Cv": {
      "PermitLimit": 10
    }
  }
}
